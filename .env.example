# --- Local dev: nothing required (embedded Postgres in .data/pgdata, `npm run dev`) ---

# --- Production (Vercel + Neon): all REQUIRED unless noted ---
# Neon *pooled* connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=
# 32+ random chars: `openssl rand -hex 32`. Encrypts WhatsApp secrets. Never change after first use.
APP_ENCRYPTION_KEY=
# First-login PIN for the doctor (production refuses to run open). You can set a personal PIN in Settings afterwards.
ADMIN_PIN=
# Protects /api/worker/tick. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Web push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourclinic.com
